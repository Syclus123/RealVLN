#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Go2 Auto Walk - 自主遛狗模式

功能：
1. 持续拍照分析前方路况
2. 使用VLM识别可行走区域和障碍物
3. 根据路况自动决策（直行、转弯、避障）
4. 动态调整行走速度
5. 检测危险区域自动停止

工作流程：
- 前方通畅 → 直行加速
- 前方有障碍 → 减速绕行
- 遇到路口 → 扫描侧方选择最佳路径
- 危险区域 → 立即停止
"""

import sys
import os
import time
import json
import subprocess
import argparse
from datetime import datetime

# 媒体保存路径
MEDIA_DIR = os.path.expanduser("~/.openclaw/media")
CAPTURE_PATH = os.path.join(MEDIA_DIR, "go2_camera.jpg")

# ========== 可配置参数 ==========
# 安全参数
SAFE_DISTANCE = 1.0      # 安全距离（米）
MIN_CLEARANCE = 0.5      # 最小通行宽度（米）
DANGER_DISTANCE = 0.3    # 危险距离（米）

# 速度参数 (m/s)
MAX_SPEED = 0.5          # 最大速度
MEDIUM_SPEED = 0.3       # 中速
SLOW_SPEED = 0.15        # 慢速
MIN_SPEED = 0.08         # 最小速度

# 时间参数
DECISION_INTERVAL = 2.0  # 决策间隔（秒）
CAPTURE_TIMEOUT = 10     # 拍照超时（秒）
ANALYSIS_TIMEOUT = 30    # VLM分析超时（秒）
MOVE_DURATION = 2.0      # 单次移动持续时间（秒）

# 扫描参数
SCAN_ANGLE = 30          # 扫描转弯角度（度）
SCAN_WAIT_TIME = 1.0     # 扫描后等待稳定时间（秒）

# 连续转向限制
MAX_CONSECUTIVE_TURNS = 3  # 最大连续转向次数，防止原地打转
consecutive_turns = 0      # 当前连续转向计数


def log(message):
    """打印带时间戳的日志"""
    timestamp = datetime.now().strftime("%H:%M:%S")
    print(f"[{timestamp}] {message}")


def capture_image():
    """拍照并返回图片路径"""
    try:
        result = subprocess.run(
            ['python3', '/home/unitree/openclaw/skills/go2-vision/scripts/capture.py'],
            capture_output=True,
            text=True,
            timeout=CAPTURE_TIMEOUT
        )
        if result.returncode == 0:
            return CAPTURE_PATH
        log(f"❌ 拍照失败: {result.stderr}")
        return None
    except Exception as e:
        log(f"❌ 拍照异常: {e}")
        return None


def analyze_road_condition(image_path):
    """
    使用VLM分析前方路况
    
    返回: {
        'walkable': bool,      # 是否可行走
        'score': int,          # 路况评分 1-5 (5=畅通, 1=危险)
        'obstacles': list,     # 检测到的障碍物
        'danger': bool,        # 是否有危险区域
        'recommended_action': str,  # 建议动作
        'clearance_left': float,    # 左侧通行空间 (米)
        'clearance_right': float,   # 右侧通行空间 (米)
        'clearance_center': float,  # 中间通行空间 (米)
    }
    """
    try:
        # VLM 提示词
        prompt = """分析这张机器狗前方视角的照片，评估路况：

请按以下JSON格式返回分析结果：
{
  "walkable": true/false,      // 前方是否有可行走的平地
  "score": 1-5,                // 路况评分：5=开阔畅通，4=良好可通行，3=一般需谨慎，2=拥挤难通行，1=危险不可走
  "obstacles": ["障碍物1", "障碍物2"],  // 检测到的障碍物列表（如：椅子、桌子、人、墙壁、门槛等）
  "danger": true/false,        // 是否有危险区域（楼梯、悬崖、大台阶、深坑等）
  "recommended_action": "动作", // 建议动作：go_forward / turn_left / turn_right / stop / back
  "clearance_left": 数值,      // 估计左侧可通行宽度（米），不知道填0.5
  "clearance_right": 数值,     // 估计右侧可通行宽度（米），不知道填0.5
  "clearance_center": 数值,    // 估计正前方可通行宽度（米），不知道填1.0
  "reason": "判断理由"         // 简短说明为什么给出这个建议
}

注意：
1. 机器狗高度约40cm，能通过的空间需要至少50cm宽
2. 楼梯、大台阶对机器狗是危险的
3. 地板、平地、短毛地毯是可行走的
4. 距离判断：画面底部是近处，顶部是远处"""

        # 尝试调用 image 工具分析（OpenClaw 环境）
        try:
            # 尝试使用 OpenClaw 的 image 工具
            import requests
            import base64
            
            # 读取图片并转为 base64
            with open(image_path, 'rb') as f:
                image_data = base64.b64encode(f.read()).decode('utf-8')
            
            # 调用本地 OpenClaw API（如果在环境中）
            # 或者使用简单模拟
            response_text = _call_vlm_with_image(image_path, prompt)
            
        except Exception as api_error:
            log(f"⚠️ VLM API调用失败，使用模拟分析: {api_error}")
            # 模拟分析结果（测试用）
            response_text = _simulate_road_analysis(image_path)
        
        # 尝试提取 JSON
        import re
        json_match = re.search(r'\{[\s\S]*\}', response_text)
        if json_match:
            json_str = json_match.group()
            analysis = json.loads(json_str)
        else:
            # 如果无法提取JSON，解析文本内容
            analysis = _parse_text_analysis(response_text)
        
        return analysis
        
    except Exception as e:
        log(f"❌ 路况分析异常: {e}")
        # 返回保守的默认结果
        return _get_default_analysis(str(e))


def _call_vlm_with_image(image_path, prompt):
    """调用VLM分析图片（尝试多种方式）"""
    
    # 方式1: 尝试使用 OpenClaw 环境变量中的 API
    openclaw_api = os.environ.get('OPENCLAW_API_URL', 'http://localhost:8080')
    
    try:
        import requests
        import base64
        
        with open(image_path, 'rb') as f:
            image_base64 = base64.b64encode(f.read()).decode('utf-8')
        
        # 尝试调用 OpenClaw 的 image 分析端点
        response = requests.post(
            f"{openclaw_api}/api/v1/analyze",
            json={
                "image": image_base64,
                "prompt": prompt
            },
            timeout=ANALYSIS_TIMEOUT
        )
        
        if response.status_code == 200:
            return response.json().get('response', '')
    except:
        pass
    
    # 方式2: 使用简单的文件读取 + 外部调用
    # 这里可以接入其他 VLM API，如 DashScope、OpenAI 等
    
    # 默认返回空，触发模拟模式
    return ""


