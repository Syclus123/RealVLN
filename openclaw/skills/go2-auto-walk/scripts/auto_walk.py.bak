    """模拟路况分析（测试用）"""
    # 实际使用时应该删除这个函数，改为真实VLM调用
    import random
    
    # 随机生成一个路况（测试用）
    scenarios = [
        {
            "walkable": True,
            "score": 5,
            "obstacles": [],
            "danger": False,
            "recommended_action": "go_forward",
            "clearance_left": 1.5,
            "clearance_right": 1.5,
            "clearance_center": 2.0,
            "reason": "前方开阔，地板平整，无障碍物，可全速前进"
        },
        {
            "walkable": True,
            "score": 4,
            "obstacles": ["椅子"],
            "danger": False,
            "recommended_action": "go_forward",
            "clearance_left": 1.0,
            "clearance_right": 0.8,
            "clearance_center": 1.2,
            "reason": "前方有可通行空间，左侧空间较大，右侧有椅子，建议保持中速"
        },
        {
            "walkable": True,
            "score": 3,
            "obstacles": ["桌子", "椅子"],
            "danger": False,
            "recommended_action": "go_forward",
            "clearance_left": 0.6,
            "clearance_right": 0.6,
            "clearance_center": 0.8,
            "reason": "前方通道较窄，两侧有桌椅，需要谨慎慢行"
        },
        {
            "walkable": True,
            "score": 2,
            "obstacles": ["柜子", "墙壁"],
            "danger": False,
            "recommended_action": "turn_left",
            "clearance_left": 0.4,
            "clearance_right": 0.3,
            "clearance_center": 0.5,
            "reason": "前方空间拥挤，左右两侧通行空间有限，建议转向探索其他方向"
        },
        {
            "walkable": False,
            "score": 1,
            "obstacles": ["楼梯"],
            "danger": True,
            "recommended_action": "stop",
            "clearance_left": 0.3,
            "clearance_right": 0.3,
            "clearance_center": 0.0,
            "reason": "⚠️ 前方检测到楼梯！这是危险区域，立即停止，后退"
        }
    ]
    
    scenario = random.choice(scenarios)
    return json.dumps(scenario, ensure_ascii=False)


def _parse_text_analysis(text):
    """从文本中解析分析结果（当JSON提取失败时使用）"""
    text_lower = text.lower()
    
    analysis = {
        'walkable': 'danger' not in text_lower and '楼梯' not in text,
        'score': 3,
        'obstacles': [],
        'danger': 'danger' in text_lower or '危险' in text or '楼梯' in text,
        'recommended_action': 'go_forward',
        'clearance_left': 0.5,
        'clearance_right': 0.5,
        'clearance_center': 1.0,
        'reason': text[:100] if text else '文本解析结果'
    }
    
    # 根据文本内容调整
    if 'stop' in text_lower or '停止' in text:
        analysis['recommended_action'] = 'stop'
        analysis['score'] = 1
    elif 'turn_left' in text_lower or '左转' in text:
        analysis['recommended_action'] = 'turn_left'
        analysis['score'] = 2
    elif 'turn_right' in text_lower or '右转' in text:
        analysis['recommended_action'] = 'turn_right'
        analysis['score'] = 2
    
    return analysis


def _get_default_analysis(error_msg=""):
    """返回默认保守分析结果"""
    return {
        'walkable': True,
        'score': 3,
        'obstacles': [],
        'danger': False,
        'recommended_action': 'go_forward',
        'clearance_left': 0.5,
        'clearance_right': 0.5,
        'clearance_center': 1.0,
        'reason': f'使用默认保守策略: {error_msg[:30]}'
    }


def control_robot(action, angle=None, duration=None, speed=None):
    """
    控制机器狗移动
    
    action: 动作名称
    angle: 转向角度（用于turn_left/turn_right）
    duration: 移动持续时间（秒）
    speed: 移动速度（m/s）
    """
    try:
        cmd = ['python3', '/home/unitree/openclaw/skills/unitree-go2/scripts/go2_control.py', action]
        if angle:
            cmd.extend(['--angle', str(angle)])
        
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
        success = result.returncode == 0
        if not success:
            log(f"⚠️ 控制命令失败: {result.stderr[:100]}")
        return success
    except Exception as e:
        log(f"❌ 控制异常: {e}")
        return False


def scan_direction(direction, angle=SCAN_ANGLE):
    """
    扫描指定方向的路况
    
    direction: 'left' 或 'right'
    返回: 路况分析结果
    """
    global consecutive_turns
    
    log(f"🔍 扫描{ '左侧' if direction == 'left' else '右侧' }路况...")
    
    # 转向指定方向
    if direction == 'left':
        control_robot('turn_left', angle=angle)
    else:
        control_robot('turn_right', angle=angle)
    
    # 等待稳定
    time.sleep(SCAN_WAIT_TIME)
    
    # 拍照分析
    image_path = capture_image()
    if not image_path:
        return None
    
    analysis = analyze_road_condition(image_path)
    
    # 转回原位
    if direction == 'left':
        control_robot('turn_right', angle=angle)
    else:
        control_robot('turn_left', angle=angle)
    
    time.sleep(0.5)
    
    if analysis:
        log(f"  {'左侧' if direction == 'left' else '右侧'}评分: {analysis['score']}/5, "
            f"建议: {analysis['recommended_action']}")
    
    return analysis


def decide_best_direction(current_analysis):
    """
    决策最佳前进方向
    
    返回: (action, angle, speed, reason)
    """
    global consecutive_turns
    
    score = current_analysis.get('score', 3)
    danger = current_analysis.get('danger', False)
    action = current_analysis.get('recommended_action', 'go_forward')
    
    # 有危险，立即停止
    if danger:
        consecutive_turns = 0
        return ('stop', 0, 0, f"检测到危险！{current_analysis.get('reason', '')}")
    
    # 路况良好，直行
    if score >= 4:
        consecutive_turns = 0
        speed = MAX_SPEED if score == 5 else MEDIUM_SPEED
        return ('move_forward', 0, speed, f"路况评分{score}/5，直行")
    
    # 路况一般，慢速直行
    if score == 3:
        consecutive_turns = 0
        return ('move_forward', 0, SLOW_SPEED, f"路况评分{score}/5，谨慎前行")
    
    # 路况较差，需要探索其他方向
    if score <= 2:
        # 防止原地打转
        if consecutive_turns >= MAX_CONSECUTIVE_TURNS:
            consecutive_turns = 0
            log("⚠️ 连续转向过多，尝试后退重新规划")
            return ('move_backward', 0, MIN_SPEED, "避免原地打转，后退重新规划")
        
        # 扫描左侧
        left_analysis = scan_direction('left')
        # 扫描右侧  
        right_analysis = scan_direction('right')
        
        left_score = left_analysis.get('score', 0) if left_analysis else 0
        right_score = right_analysis.get('score', 0) if right_analysis else 0
        
        # 选择评分更高的方向
        if left_score > score or right_score > score:
            if left_score >= right_score and left_score > 0:
                consecutive_turns += 1
                return ('turn_left', SCAN_ANGLE, MIN_SPEED, f"左侧评分{left_score} > 前方{score}，左转")
            else:
                consecutive_turns += 1
                return ('turn_right', SCAN_ANGLE, MIN_SPEED, f"右侧评分{right_score} > 前方{score}，右转")
        else:
            # 所有方向都不好，尝试慢速前进或后退
            if score == 2:
                consecutive_turns = 0
                return ('move_forward', 0, MIN_SPEED, f"各方向均不佳，极慢速尝试前行")
            else:
                consecutive_turns = 0
                return ('stop', 0, 0, f"前方危险，停止等待")
    
    # 默认策略
    consecutive_turns = 0
    return ('move_forward', 0, SLOW_SPEED, "默认策略：谨慎前行")


def execute_movement(action, angle, speed, duration=MOVE_DURATION):
    """
    执行移动动作
    
    返回: 是否成功
    """
    if action == 'stop':
        log("🛑 停止")
        return control_robot('stop')
    
    elif action == 'move_forward':
        log(f"⬆️  前进 (速度{speed:.2f}m/s, {duration}秒)")
        # 使用持续移动
        try:
            cmd = ['python3', '/home/unitree/openclaw/skills/unitree-go2/scripts/go2_control.py', 'move_forward']
            result = subprocess.run(cmd, capture_output=True, text=True, timeout=duration + 5)
            return result.returncode == 0
        except Exception as e:
            log(f"⚠️ 前进异常: {e}")
            return False
    
    elif action == 'move_backward':
        log(f"⬇️  后退 (速度{MIN_SPEED:.2f}m/s)")
        return control_robot('move_backward')
    
    elif action == 'turn_left':
        log(f"⬅️  左转 {angle}度")
        return control_robot('turn_left', angle=angle)
    
    elif action == 'turn_right':
        log(f"➡️  右转 {angle}度")
        return control_robot('turn_right', angle=angle)
    
    return False


def auto_walk(duration_seconds=0, network_interface='eth0'):
    """
    自主行走主循环
    
    duration_seconds: 行走持续时间，0表示无限
    """
    global consecutive_turns
    
    log("=" * 60)
    log("🐕 启动自主遛狗模式 (Auto Walk)")
    log("=" * 60)
    log("工作原理:")
    log("  📷 拍照 → 🔍 VLM分析路况 → 🧠 决策 → 🏃 执行 → 🔄 循环")
    log("")
    log("速度等级:")
    log(f"  🚀 快速: {MAX_SPEED} m/s (路况评分5)")
    log(f"  ⚡ 中速: {MEDIUM_SPEED} m/s (路况评分4)")
    log(f"  🐢 慢速: {SLOW_SPEED} m/s (路况评分3)")
    log(f"  🐌 极慢: {MIN_SPEED} m/s (路况评分2)")
    log("")
    log("安全机制:")
    log("  ⚠️  检测到危险区域自动停止")
    log("  🔄 连续转向超过3次会后退重新规划")
    log("  🛑 按 Ctrl+C 立即停止")
    log("=" * 60)
    log("")
    
    # 确保站立
    log("🦮 准备出发...")
    control_robot('stand_up')
    time.sleep(1)
    
    start_time = time.time()
    iteration = 0
    consecutive_turns = 0
    
    try:
        while True:
            iteration += 1
            elapsed = time.time() - start_time
            
            # 检查是否超时
            if duration_seconds > 0 and elapsed >= duration_seconds:
                log(f"⏰ 达到设定时间 {duration_seconds}秒，停止行走")
                break
            
            log(f"\n--- 第{iteration}轮决策 (已行走{elapsed:.1f}秒) ---")
            
            # 1. 拍照
            log("📷 拍照分析路况...")
            image_path = capture_image()
            if not image_path:
                log("❌ 拍照失败，等待后重试")
                time.sleep(DECISION_INTERVAL)
                continue
            
            # 2. 分析路况
            log("🧠 VLM分析中...")
            analysis = analyze_road_condition(image_path)
            
            score = analysis.get('score', 0)
            obstacles = analysis.get('obstacles', [])
            danger = analysis.get('danger', False)
            reason = analysis.get('reason', '')
            
            log(f"📊 路况评分: {score}/5")
            if obstacles:
                log(f"🚧 检测到障碍物: {', '.join(obstacles)}")
            if danger:
                log(f"⚠️  检测到危险区域！")
            log(f"💡 分析理由: {reason[:80]}...")
            
            # 3. 决策
            action, angle, speed, decision_reason = decide_best_direction(analysis)
            log(f"🎯 决策: {decision_reason}")
            
            # 4. 执行动作
            execute_movement(action, angle, speed)
            
            # 5. 等待下一次决策
            log(f"⏳ 等待{DECISION_INTERVAL}秒后进行下一轮...")
            time.sleep(DECISION_INTERVAL)
            
    except KeyboardInterrupt:
        log("\n🛑 收到停止指令")
    except Exception as e:
        log(f"\n❌ 发生异常: {e}")
    
    # 清理
    log("🧹 清理...")
    control_robot('stop')
    time.sleep(0.5)
    log("✅ 自主行走模式已停止")


def test_mode():
    """测试模式：只分析路况，不移动"""
    log("=" * 60)
    log("🧪 测试模式 - 只分析路况，不移动")
    log("=" * 60)
    
    log("📷 拍照...")
    image_path = capture_image()
    if not image_path:
        log("❌ 拍照失败")
        return
    
    log("🧠 分析路况...")
    analysis = analyze_road_condition(image_path)
    
    log("\n📊 分析结果:")
    log(f"  可行走: {'✅' if analysis.get('walkable') else '❌'}")
    log(f"  路况评分: {analysis.get('score', 0)}/5")
    log(f"  障碍物: {', '.join(analysis.get('obstacles', []))}")
    log(f"  危险区域: {'⚠️ 有' if analysis.get('danger') else '✅ 无'}")
    log(f"  建议动作: {analysis.get('recommended_action', 'unknown')}")
    log(f"  左侧空间: {analysis.get('clearance_left', 0)}米")
    log(f"  右侧空间: {analysis.get('clearance_right', 0)}米")
    log(f"  中间空间: {analysis.get('clearance_center', 0)}米")
    log(f"  理由: {analysis.get('reason', 'N/A')}")
    
    # 显示决策
    action, angle, speed, reason = decide_best_direction(analysis)
    log(f"\n🎯 系统决策: {action}")
    log(f"   角度: {angle}度, 速度: {speed}m/s")
    log(f"   理由: {reason}")


def main():
    """主函数"""
    parser = argparse.ArgumentParser(
        description='Go2 自主遛狗模式 - 自动发现路径、避障、导航',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
示例:
  python3 auto_walk.py                    # 持续自主行走
  python3 auto_walk.py -d 60              # 行走60秒后停止
  python3 auto_walk.py -t                 # 测试模式（只分析不移动）
  python3 auto_walk.py -n eth0            # 指定网络接口
        """
    )
    
    parser.add_argument('--duration', '-d', type=int, default=0,
                        help='行走持续时间（秒），0表示无限（默认：0）')
    parser.add_argument('--test', '-t', action='store_true',
                        help='测试模式：只拍照分析路况，不移动')
    parser.add_argument('--network', '-n', type=str, default='eth0',
                        help='网络接口名称（默认：eth0）')
    
    args = parser.parse_args()
    
    if args.test:
        test_mode()
    else:
        auto_walk(duration_seconds=args.duration)


if __name__ == '__main__':
    main()
