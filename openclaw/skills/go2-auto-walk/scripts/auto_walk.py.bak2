#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import sys
import time
import cv2
import torch
import numpy as np
import threading
import argparse

# 导入宇树 SDK
from unitree_sdk2py.core.channel import ChannelFactoryInitialize
from unitree_sdk2py.go2.video.video_client import VideoClient
from unitree_sdk2py.go2.sport.sport_client import SportClient

# ==========================================
# 🚀 极速避障参数配置
# ==========================================
NETWORK_INTERFACE = "eth0"

# 运动参数
MAX_SPEED = 0.35          # 巡航直线速度
MIN_SPEED = 0.15          # 谨慎直线速度
TURN_SPEED = 0.6          # 避障转向角速度
RECOVERY_SPEED = -0.2     # 倒车速度

# 深度阈值 (0-255，值越大离得越近)
# ⚠️ 注意：这个值需要根据你家环境光线和实际运行情况微调
OBSTACLE_THRESHOLD = 140  # 认定为“有障碍物”的深度浓度
DANGER_THRESHOLD = 180    # 认定为“快撞上了”的极度危险浓度

cmd_state = {
    "vx": 0.0,
    "vyaw": 0.0,
    "active": True,
    "state": "IDLE"
}

# ==========================================
# 🧠 大脑：MiDaS 深度感知线程
# ==========================================
def perception_thread(video_client, show_cv=False):
    print("🟢 [深度大脑] 正在加载 MiDaS 轻量级深度模型 (可能需要几秒下载)...")
    
    # 使用 GPU (Jetson Orin 完美支持)
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    
    # 加载 MiDaS Small 模型 (极其轻量，推理极快)
    midas = torch.hub.load("intel-isl/MiDaS", "MiDaS_small", trust_repo=True)
    midas.to(device)
    midas.eval()

    # 加载预处理管道
    midas_transforms = torch.hub.load("intel-isl/MiDaS", "transforms", trust_repo=True)
    transform = midas_transforms.small_transform

    print(f"🟢 [深度大脑] 模型加载完毕，运行在 {device} 上！开始极速感知！")

    while cmd_state["active"]:
        start_time = time.time()
        
        # 1. 获取画面
        code, data = video_client.GetImageSample()
        if code != 0:
            time.sleep(0.01)
            continue
            
        np_arr = np.frombuffer(bytes(data), np.uint8)
        img = cv2.imdecode(np_arr, cv2.IMREAD_COLOR)
        img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)

        # 2. 深度推理
        input_batch = transform(img_rgb).to(device)
        with torch.no_grad():
            prediction = midas(input_batch)
            # 调整回原图大小
            prediction = torch.nn.functional.interpolate(
                prediction.unsqueeze(1),
                size=img.shape[:2],
                mode="bicubic",
                align_corners=False,
            ).squeeze()
        
        # 将深度值归一化到 0-255 方便计算和可视化 (值越大越近)
        depth_map = prediction.cpu().numpy()
        depth_map = cv2.normalize(depth_map, None, 0, 255, norm_type=cv2.NORM_MINMAX, dtype=cv2.CV_8U)

        # 3. 画面切片与浓度计算 (重点关注画面的下半部分，即狗的脚下)
        h, w = depth_map.shape
        roi_top = int(h * 0.4) # 从画面 40% 处往下看，忽略天花板
        
        # 切分左、中、右
        w_third = w // 3
        left_roi = depth_map[roi_top:, :w_third]
        center_roi = depth_map[roi_top:, w_third:2*w_third]
        right_roi = depth_map[roi_top:, 2*w_third:]

        # 计算 90% 分位数浓度 (比平均值更能代表突出的障碍物)
        left_val = np.percentile(left_roi, 90)
        center_val = np.percentile(center_roi, 90)
        right_val = np.percentile(right_roi, 90)

        # 4. 扫地机反射神经决策
        v_x, v_yaw = 0.0, 0.0
        state_str = ""

        if center_val > DANGER_THRESHOLD and left_val > DANGER_THRESHOLD and right_val > DANGER_THRESHOLD:
            # 死胡同，倒车
            v_x = RECOVERY_SPEED
            v_yaw = TURN_SPEED # 一边倒一边转
            state_str = "🚨 死胡同! 倒车"
        elif center_val < OBSTACLE_THRESHOLD:
            # 前方空旷，直行
            v_x = MAX_SPEED
            v_yaw = (left_val - right_val) * 0.005 
            state_str = "⬆️ 畅通直行"
        else:
            # ⚠️ 前方堵塞，需转向。果断放弃前进，原地打死方向盘！
            v_x = 0.0  # <--- 之前这里是减速摸索，太慢导致狗子不动，现在改为 0
            if left_val < right_val:
                v_yaw = TURN_SPEED
                state_str = "⬅️ 原地左转"
            else:
                v_yaw = -TURN_SPEED
                state_str = "➡️ 原地右转"

        cmd_state["vx"] = v_x
        cmd_state["vyaw"] = v_yaw
        cmd_state["state"] = state_str

        # 帧率计算
        fps = 1.0 / (time.time() - start_time)
        print(f"\r\033[K[感知 {fps:.1f}Hz] {state_str} | 浓度(左:{left_val:.0f} 中:{center_val:.0f} 右:{right_val:.0f})", end="", flush=True)

        # 5. [可选] 可视化调试
        if show_cv:
            # 涂上颜色更好看 (近红远蓝)
            depth_color = cv2.applyColorMap(depth_map, cv2.COLORMAP_JET)
            # 画线分割区域
            cv2.line(depth_color, (w_third, roi_top), (w_third, h), (255,255,255), 2)
            cv2.line(depth_color, (2*w_third, roi_top), (2*w_third, h), (255,255,255), 2)
            cv2.line(depth_color, (0, roi_top), (w, roi_top), (0,255,0), 2)
            cv2.imshow("Go2 Cyber Depth", depth_color)
            if cv2.waitKey(1) & 0xFF == ord('q'):
                cmd_state["active"] = False

# ==========================================
# 🦴 小脑：高频运动控制线程 (解除封印版)
# ==========================================
def control_thread(sport_client):
    print("\n🟢 [底盘小脑] 25Hz 纯净动力控制启动...")
    real_vx, real_vyaw = 0.0, 0.0
    S_VEL = 0.3  # 平滑系数
    
    # ⚠️ 删掉所有的 StandUp, BalanceStand 和 Euler!
    # 让狗子保持原本的运动状态，不要强行切模式
    time.sleep(1.0) # 等待感知线程先跑起来获取第一帧数据
    
    try:
        while cmd_state["active"]:
            t_vx = cmd_state["vx"]
            t_vyaw = cmd_state["vyaw"]

            # 物理平滑
            real_vx += S_VEL * (t_vx - real_vx)
            real_vyaw += S_VEL * (t_vyaw - real_vyaw)
            
            # 清除微小死区
            if abs(real_vx) < 0.02: real_vx = 0.0
            if abs(real_vyaw) < 0.05: real_vyaw = 0.0

            # ⚠️ 纯净下发 Move，如果是静止状态就发送 StopMove
            if real_vx == 0.0 and real_vyaw == 0.0:
                sport_client.StopMove()
            else:
                sport_client.Move(real_vx, 0.0, real_vyaw)
                
            time.sleep(0.04) # 严格 25Hz
            
    except Exception as e:
        print(f"\n❌ 控制崩溃: {e}")
    finally:
        sport_client.StopMove()
        print("\n✅ 底盘已锁死")




# ==========================================
# 主程序
# ==========================================
def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--show", action="store_true", help="显示深度热力图窗口 (需要图形界面支持)")
    args = parser.parse_args()

    print("=" * 60)
    print("🐕 Go2 Auto Roam - 极速深度避障版 (扫地僧模式)")
    print("=" * 60)
    
    ChannelFactoryInitialize(0, NETWORK_INTERFACE)
    video_client = VideoClient()
    video_client.Init()
    sport_client = SportClient()
    sport_client.Init()
    
    # 启动双线程
    t_perc = threading.Thread(target=perception_thread, args=(video_client, args.show))
    t_ctrl = threading.Thread(target=control_thread, args=(sport_client,))
    
    t_perc.start()
    t_ctrl.start()
    
    try:
        while cmd_state["active"]:
            time.sleep(1)
    except KeyboardInterrupt:
        print("\n🛑 收到退出指令...")
        cmd_state["active"] = False
        t_perc.join()
        t_ctrl.join()

if __name__ == "__main__":
    main()
