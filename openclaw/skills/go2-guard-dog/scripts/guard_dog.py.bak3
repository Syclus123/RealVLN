#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import sys
import os
import time
import cv2
import numpy as np
import threading
import argparse
from ultralytics import YOLO

# 导入宇树 SDK
from unitree_sdk2py.core.channel import ChannelFactoryInitialize
from unitree_sdk2py.go2.video.video_client import VideoClient
from unitree_sdk2py.go2.sport.sport_client import SportClient

# 动态导入语音技能
sys.path.insert(0, '/home/unitree/openclaw/skills/go2-audio-play/scripts')
from play import play_sound

# ==========================================
# 配置与阈值
# ==========================================
NETWORK_INTERFACE = "eth0"
MODEL_PATH = '/home/unitree/openclaw/skills/unitree-go2/yolov8n.pt'
SOUND_PATH = '/home/unitree/openclaw/skills/go2-audio-play/sounds/dog_barking.wav'

WARN_DISTANCE = 2.0      
DANGER_DISTANCE = 1.0    
RETREAT_SPEED = -0.2     

# 姿态参数：显著增大前倾角度以实现“前压”感
POUNCE_PITCH = 0.45      # 增大到约 25-30 度，低头前倾
BARK_INTERVAL = 1.2      
SMOOTH_FACTOR = 0.15     

DISTANCE_Y2_MAP = {
    0.70: 3.0,   
    0.80: 2.0,   
    0.90: 1.0,   
    0.95: 0.5,   
}

cmd_state = {
    "vx": 0.0,
    "vyaw": 0.0,
    "pitch": 0.0,
    "last_update": 0.0
}

class GuardState:
    IDLE = "idle"
    WATCHING = "watching"
    BARKING = "barking"     
    RETREATING = "retreating"

bark_event = threading.Event()

# ==========================================
# 1. 音频守护线程
# ==========================================
def audio_worker_thread():
    print("🟢 [音频线程] 真声服务已就绪...")
    while True:
        if bark_event.is_set():
            try:
                play_sound(SOUND_PATH)
            except Exception as e:
                print(f"❌ 播放异常: {e}")
            time.sleep(BARK_INTERVAL)
            bark_event.clear()
        else:
            time.sleep(0.05)

# ==========================================
# 2. 运动控制线程 (移除报错的 BodyHeight)
# ==========================================
def control_thread_task(sport_client):
    print("🟢 [控制线程] 姿态控制已启动 (Pitch Only)...")
    real_vx, real_vyaw, real_pitch = 0.0, 0.0, 0.0
   
    # 在进入循环前，尝试先呼叫一次站立平衡重置
    sport_client.BalanceStand() 
    time.sleep(0.5) 
  
    try:
        while True:
            if time.time() - cmd_state["last_update"] > 0.5:
                t_vx, t_vyaw, t_pitch = 0.0, 0.0, 0.0
            else:
                t_vx = cmd_state["vx"]
                t_vyaw = cmd_state["vyaw"]
                t_pitch = cmd_state["pitch"]

            # 平滑过渡
            real_vx += SMOOTH_FACTOR * (t_vx - real_vx)
            real_vyaw += SMOOTH_FACTOR * (t_vyaw - real_vyaw)
            real_pitch += SMOOTH_FACTOR * (t_pitch - real_pitch)

            # 核心修改：如果处于警戒状态（pitch > 0），我们需要高频发送 Euler 指令
            # 并在某些 SDK 版本中，Euler 需要配合一个微小的 BodyHeight(0) 
            # 或特定的状态指令来抢占自平衡优先级。
            
            if abs(real_pitch) > 0.01:
                # 方案 A: 强制下发 Euler
                sport_client.Euler(0.0, real_pitch, 0.0)
                # 方案 B: 在发送 Euler 的同时，发送一个 Move(0,0,0) 来确保它不处于自由行走导致被平衡
                sport_client.Move(real_vx, 0.0, real_vyaw)
            else:
                # 恢复水平
                sport_client.Move(real_vx, 0.0, real_vyaw)
                sport_client.Euler(0.0, 0.0, 0.0)

            time.sleep(0.05)
    except Exception as e:
        print(f"❌ [控制线程] 严重异常: {e}")
    finally:
        sport_client.StopMove()
        sport_client.Euler(0.0, 0.0, 0.0)

# ==========================================
# 3. 核心决策大脑
# ==========================================
def estimate_distance(y2):
    y2_p = sorted(DISTANCE_Y2_MAP.keys())
    d_p = [DISTANCE_Y2_MAP[y] for y in y2_p]
    return np.interp(y2, y2_p, d_p)

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--test", action="store_true")
    args = parser.parse_args()

    print("="*50)
    print("🐕 Go2 Guard Dog V3 - 前压姿态锁定版")
    print("="*50)

    ChannelFactoryInitialize(0, NETWORK_INTERFACE)
    video_client = VideoClient()
    video_client.Init()

    sport_client = None
    if not args.test:
        sport_client = SportClient()
        sport_client.Init()
        # 强制让狗子进入站立/稳定模式，否则 Euler 指令可能无效
        print("💡 正在确保狗子处于稳定模式...")

    model = YOLO(MODEL_PATH)
    model(np.zeros((640, 640, 3), dtype=np.uint8), verbose=False)

    threading.Thread(target=audio_worker_thread, daemon=True).start()
    if sport_client:
        threading.Thread(target=control_thread_task, args=(sport_client,), daemon=True).start()

    current_state = GuardState.IDLE
    last_action_desc = ""

    try:
        while True:
            code, data = video_client.GetImageSample()
            if code != 0: continue
            
            img = cv2.imdecode(np.frombuffer(bytes(data), np.uint8), cv2.IMREAD_COLOR)
            results = model.track(img, classes=[0], conf=0.45, persist=True, tracker="botsort.yaml", verbose=False)
            
            person_detected = False
            target_h, target_y2 = 0.0, 0.0
            
            if results[0].boxes.id is not None:
                boxes = results[0].boxes.xyxy.cpu().numpy()
                max_area = 0
                for box in boxes:
                    x1, y1, x2, y2 = box
                    area = (x2-x1)*(y2-y1)
                    if area > max_area:
                        max_area = area
                        person_detected = True
                        target_h = ((x1 + x2) / (2 * img.shape[1]) - 0.5) * 2
                        target_y2 = y2 / img.shape[0]

            v_x, v_yaw, p_pitch = 0.0, 0.0, 0.0
            
            if person_detected:
                dist = estimate_distance(target_y2)
                v_yaw = -target_h * 1.5
                v_yaw = max(-0.8, min(0.8, v_yaw))

                if dist > WARN_DISTANCE:
                    new_state = GuardState.WATCHING
                    action_desc = f"👀 锁定目标 [距 {dist:.1f}m]"
                elif dist > DANGER_DISTANCE:
                    new_state = GuardState.BARKING
                    action_desc = f"🚨 猛犬前压警告! [距 {dist:.1f}m]"
                    bark_event.set()
                    p_pitch = POUNCE_PITCH # 激活前压
                else:
                    new_state = GuardState.RETREATING
                    action_desc = f"🐕 压低重心退防 [距 {dist:.1f}m]"
                    v_x = RETREAT_SPEED
                    bark_event.set()
                    p_pitch = POUNCE_PITCH # 激活前压
            else:
                new_state = GuardState.IDLE
                action_desc = "😌 区域安全，持续监视中..."

            if not args.test:
                cmd_state["vx"] = v_x
                cmd_state["vyaw"] = v_yaw
                cmd_state["pitch"] = p_pitch
                cmd_state["last_update"] = time.time()

            # 滚动打印日志，仅在状态变化或有入侵者时打印
            if action_desc != last_action_desc:
                print(f"[{time.strftime('%H:%M:%S')}] {action_desc} (Pitch: {p_pitch:.2f})")
                last_action_desc = action_desc

    except KeyboardInterrupt:
        print("\n🛑 安全退出中...")
        if sport_client:
            sport_client.StopMove()
            sport_client.Euler(0,0,0)

if __name__ == "__main__":
    main()
